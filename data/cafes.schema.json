{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nomadly.example/schemas/cafes.schema.json",
  "title": "Cafe catalogue",
  "type": "array",
  "items": { "$ref": "#/definitions/cafe" },
  "definitions": {
    "nullableScore": { "type": ["number", "null"], "minimum": 0, "maximum": 5 },
    "hours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["open", "close"],
      "properties": {
        "open": { "type": ["string", "null"], "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
        "close": { "type": ["string", "null"], "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" }
      },
      "oneOf": [
        { "properties": { "open": { "type": "string" }, "close": { "type": "string" } } },
        { "properties": { "open": { "type": "null" }, "close": { "type": "null" } } }
      ]
    },
    "businessHours": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["weekly", "regularClosedDays"],
      "properties": {
        "weekly": {
          "type": "object",
          "additionalProperties": false,
          "required": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"],
          "properties": {
            "monday": { "$ref": "#/definitions/hours" }, "tuesday": { "$ref": "#/definitions/hours" },
            "wednesday": { "$ref": "#/definitions/hours" }, "thursday": { "$ref": "#/definitions/hours" },
            "friday": { "$ref": "#/definitions/hours" }, "saturday": { "$ref": "#/definitions/hours" },
            "sunday": { "$ref": "#/definitions/hours" }
          }
        },
        "regularClosedDays": { "type": "array", "items": { "type": "string" } }
      }
    },
    "cafe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "address", "area", "latitude", "longitude", "features", "businessHours", "googleMapsUrl", "workabilityScore", "coffeeScore", "atmosphereScore", "googlePlaceId", "googleRating", "googleUserRatingsTotal", "googleUpdatedAt", "publishedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "address": { "type": "string", "minLength": 1 },
        "area": { "type": "string", "minLength": 1 },
        "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
        "features": { "type": "array", "uniqueItems": true, "items": { "enum": ["wifi", "power-outlets", "quiet", "long-stay-friendly", "open-late", "spacious", "scenic-view"] } },
        "businessHours": { "$ref": "#/definitions/businessHours" },
        "googleMapsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "workabilityScore": { "$ref": "#/definitions/nullableScore" },
        "coffeeScore": { "$ref": "#/definitions/nullableScore" },
        "atmosphereScore": { "$ref": "#/definitions/nullableScore" },
        "googlePlaceId": { "type": "string", "minLength": 1 },
        "googleRating": { "$ref": "#/definitions/nullableScore" },
        "googleUserRatingsTotal": { "type": ["integer", "null"], "minimum": 0 },
        "googleUpdatedAt": { "type": "string", "format": "date-time" },
        "publishedAt": { "type": "string", "format": "date" }
      }
    }
  }
}
